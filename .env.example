# Cutlass local configuration.
# Copy to .env and fill in your key:  cp .env.example .env
# .env is gitignored — never commit real keys.

# ── Model access ────────────────────────────────────────────────────────────
# API key (z.ai open platform, GLM Coding Plan key, or any OpenAI-compatible
# provider's key). For local dev without any key, set DRY_RUN=1.
GLM_API_KEY=

# Base URL of an OpenAI-compatible /chat/completions endpoint.
#   z.ai open platform (pay per use): https://api.z.ai/api/paas/v4
#   GLM Coding Plan (subscription):    https://api.z.ai/api/coding/paas/v4
#   OpenAI:                            https://api.openai.com/v1
# Note: the Coding Plan endpoint is intended for supported coding tools, has
# no /audio/transcriptions, and only glm-5.3-flash accepts images.
MODEL_BASE_URL=https://api.z.ai/api/paas/v4

# Vision model (must accept image input, e.g. glm-5.3-flash / gpt-4o).
VISION_MODEL=glm-4.5v

# Text model for the segment-selection pass (cheaper is fine).
TEXT_MODEL=glm-4.5-air

# ── Audio transcription ─────────────────────────────────────────────────────
# Requires an endpoint with /audio/transcriptions (not the Coding Plan one).
TRANSCRIBE_ENABLED=1
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_CHUNK_S=600

# ── Pipeline tuning ─────────────────────────────────────────────────────────
SAMPLE_INTERVAL_S=2.0   # seconds between sampled frames
CHUNK_SIZE=40           # frames per model call
QUEUE_WORKERS=2         # concurrent analysis/render workers
MAX_UPLOAD_GB=2.0       # upload size limit

# ── Dev flags ───────────────────────────────────────────────────────────────
# DRY_RUN=1 stubs all model calls so the pipeline runs without any API key.
DRY_RUN=0
